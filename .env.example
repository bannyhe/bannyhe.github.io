# URL of the analytics backend server.
# Development: http://localhost:3001
# Production: https://your-backend.railway.app (or Render, etc.)
VITE_ANALYTICS_URL=http://localhost:3001

# Access code for the VCF Network case study.
#
# This is a courtesy gate, not a security control: anything compared in the
# browser ends up in the JavaScript bundle, so a determined visitor can read it.
# It keeps the work out of search results and away from casual browsing. Do not
# publish anything genuinely covered by an NDA behind it.
#
# Set the same value as the VITE_VCF_PROJECT_PASSWORD repository secret so
# production builds pick it up. If it is unset, the case study stays locked and
# shows a "get in touch" message instead of a password field.
VITE_VCF_PROJECT_PASSWORD=
